import json
import re
import threading
import time
import traceback
import uuid
from collections import deque
from typing import Any, List

from base_plugin import BasePlugin, MethodHook
from hook_utils import set_static_private_field
from ui.settings import Header, Switch, Selector, Text, Divider
from ui.bulletin import BulletinHelper

from android.media import MediaCodecList
from android.os import Build
from android.util import Log
from java.lang import Boolean, Class
from java.net import URL
from java.util import ArrayList

__id__ = "av1_sw_decoder"
__name__ = "AV1 Software Decoder"
__description__ = (
    "Позволяет воспроизводить AV1-видео программным декодером "
    "(c2.android.av1-dav1d / libgav1) на устройствах без аппаратной поддержки AV1."
)
__author__ = "stxlvn"
__version__ = "1.1.1"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"

AV1_CODECS = ("av1", "av01")
AV1_MIME = "video/av01"
UNSUPPORTED_PREF = "unsupport_" + AV1_MIME
DAV1D_MARK = "dav1d"

MODE_FALLBACK = 0
MODE_ALWAYS = 1

MAX_RES_ITEMS = ["480p", "720p", "1080p", "1440p", "Без ограничений"]
MAX_RES_VALUES = [480, 720, 1080, 1440, 1 << 30]
MAX_RES_DEFAULT = 2

LOG_URL = "https://stxlvn.tech/av1log"
LOG_EVENTS_MAX = 400
LOG_PAYLOAD_MAX = 200 * 1024
LOG_DEDUPE_MAX = 200
PRIVATE_RE = re.compile(r"(tg://\S+|/storage/\S+|/data/\S+|file://\S+|https?://\S+)")


def load_class(name):
    try:
        from org.telegram.messenger import ApplicationLoader
        return Class.forName(name, False, ApplicationLoader.applicationContext.getClassLoader())
    except Exception:
        return None


def jlist(collection) -> list:
    if isinstance(collection, list):
        return collection
    return [collection.get(i) for i in range(collection.size())]


def is_av1(codec) -> bool:
    return codec is not None and str(codec).lower() in AV1_CODECS


def quality_p(width: int, height: int) -> int:
    return min(width, height)


def describe_qualities(qualities) -> str:
    return "; ".join(
        ",".join(f"{u.codec}:{u.width}x{u.height}{'(orig)' if u.original else ''}" for u in jlist(q.uris))
        for q in jlist(qualities)
    )


def filter_qualities(qualities, mode: int, max_p: int) -> bool:
    """Drop AV1 variants per mode/resolution cap. Mutates in place, returns True if changed."""
    all_uris = [u for q in jlist(qualities) for u in jlist(q.uris)]
    av1 = [u for u in all_uris if is_av1(u.codec)]
    if not av1:
        return False

    has_other = len(av1) != len(all_uris)
    if mode == MODE_FALLBACK and has_other:
        drop = av1
    else:
        drop = [u for u in av1 if quality_p(u.width, u.height) > max_p]
        if len(drop) == len(all_uris):
            smallest = min(drop, key=lambda u: u.width * u.height)
            drop = [u for u in drop if u != smallest]
    if not drop:
        return False

    for q in list(jlist(qualities)):
        for u in list(jlist(q.uris)):
            if any(u == d for d in drop):
                q.uris.remove(u)
        if not jlist(q.uris):
            qualities.remove(q)
    return True


def scan_av1_decoders():
    hw, sw = [], []
    try:
        infos = MediaCodecList(MediaCodecList.ALL_CODECS).getCodecInfos()
    except Exception:
        return hw, sw
    sdk = Build.VERSION.SDK_INT
    for info in infos:
        try:
            if info.isEncoder():
                continue
            if not any(t.lower() == AV1_MIME for t in info.getSupportedTypes()):
                continue
            name = info.getName()
            if sdk >= 29:
                software = info.isSoftwareOnly() or not info.isHardwareAccelerated()
            else:
                lname = name.lower()
                software = lname.startswith(("omx.google.", "c2.android.", "c2.google.")) or not lname.startswith(("omx.", "c2."))
            max_w = max_h = 0
            try:
                vc = info.getCapabilitiesForType(AV1_MIME).getVideoCapabilities()
                max_w = int(vc.getSupportedWidths().getUpper())
                max_h = int(vc.getSupportedHeights().getUpper())
            except Exception:
                pass
            (sw if software else hw).append((name, max_w, max_h))
        except Exception:
            continue
    sw.sort(key=lambda d: 0 if DAV1D_MARK in d[0].lower() else 1)
    return hw, sw


class Diagnostics:
    def __init__(self, plugin):
        self.plugin = plugin
        self.session = uuid.uuid4().hex[:12]
        self.events = deque(maxlen=LOG_EVENTS_MAX)
        self.seen = set()
        self.lock = threading.Lock()
        self.timer = None
        self.reasons = []

    def add(self, message: str, limit: int = 1500):
        line = f"{time.strftime('%H:%M:%S')} {PRIVATE_RE.sub('<redacted>', str(message))[:limit]}"
        with self.lock:
            self.events.append(line)
        self.plugin.log(line)

    def once(self, key: str, message: str):
        if key in self.seen or len(self.seen) >= LOG_DEDUPE_MAX:
            return
        self.seen.add(key)
        self.add(message)

    def exception(self, where: str):
        self.add(f"EXC in {where}: {traceback.format_exc()}", limit=4000)

    def schedule(self, reason: str, delay: float):
        if not self.plugin.get_setting("send_logs", True):
            return
        with self.lock:
            self.reasons.append(reason)
            if self.timer is not None:
                return
            self.timer = threading.Timer(delay, self._flush)
            self.timer.daemon = True
            self.timer.start()

    def cancel(self):
        with self.lock:
            if self.timer is not None:
                self.timer.cancel()
                self.timer = None

    def _flush(self):
        with self.lock:
            self.timer = None
            reasons, self.reasons = self.reasons, []
        self.send(",".join(reasons))

    def send(self, reason: str) -> bool:
        try:
            with self.lock:
                events = list(self.events)
            payload = dict(self.plugin.environment(), session=self.session, reason=reason, events=events)
            data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
            while len(data) > LOG_PAYLOAD_MAX and payload["events"]:
                payload["events"] = payload["events"][len(payload["events"]) // 4 + 1:]
                data = json.dumps(payload, ensure_ascii=False).encode("utf-8")

            conn = URL(LOG_URL).openConnection()
            conn.setRequestMethod("POST")
            conn.setDoOutput(True)
            conn.setConnectTimeout(15000)
            conn.setReadTimeout(15000)
            conn.setRequestProperty("Content-Type", "application/json; charset=utf-8")
            out = conn.getOutputStream()
            out.write(data)
            out.close()
            code = conn.getResponseCode()
            conn.disconnect()
            self.plugin.log(f"diagnostics sent ({reason}): HTTP {code}")
            return 200 <= code < 300
        except Exception as e:
            self.plugin.log(f"diagnostics send failed: {e}")
            return False


class SupportsDecoderHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            codec = param.args[0]
            original = bool(param.getResult())
            override = not original and is_av1(codec) and self.plugin.can_override()
            self.plugin.diag.once(
                f"shd:{codec}:{original}:{override}",
                f"supportsHardwareDecoder({codec}) = {original}{' -> override True' if override else ''}",
            )
            if override:
                self.plugin.override_used = True
                param.setResult(True)
        except Exception:
            self.plugin.diag.exception("supportsHardwareDecoder")


class QualitiesHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            qualities = param.getResult()
            if qualities is None or not self.plugin.can_override():
                return
            before = describe_qualities(qualities)
            changed = filter_qualities(qualities, self.plugin.mode(), self.plugin.max_p())
            if "av1" in before or "av01" in before:
                after = describe_qualities(qualities) if changed else "unchanged"
                self.plugin.diag.once(f"q:{before}:{after}", f"getQualities: [{before}] -> [{after}]")
        except Exception:
            self.plugin.diag.exception("getQualities")


class QualityForPlayerHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            uri = param.getResult()
            if uri is not None:
                self.plugin.diag.once(
                    f"qfp:{uri.codec}:{uri.width}x{uri.height}:{uri.original}",
                    f"getQualityForPlayer -> {uri.codec} {uri.width}x{uri.height} original={uri.original}",
                )
        except Exception:
            self.plugin.diag.exception("getQualityForPlayer")


class PlayerErrorHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            error = param.args[len(param.args) - 1]
            if error is None:
                return
            cause = error.getCause()
            self.plugin.diag.add(f"onPlayerError: {Log.getStackTraceString(error)}", limit=6000)
            self.plugin.diag.schedule("player_error", 3)
            if not self.plugin.override_used or self.plugin.sw_failed:
                return
            text = f"{error} {cause}".lower()
            if "av01" in text or "av1" in text:
                self.plugin.sw_failed = True
                self.plugin.diag.add("software AV1 decoding failed -> override disabled until restart")
                BulletinHelper.show_error("AV1: программный декодер не справился, отключён до перезапуска")
        except Exception:
            self.plugin.diag.exception("onPlayerError")


class FirstFrameHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        self.plugin.diag.add("onRenderedFirstFrame")


class DecoderInfosHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if param.args[0] != AV1_MIME or param.getResult() is None:
                return
            infos = list(jlist(param.getResult()))
            names = [f"{i.name}{'(sw)' if i.softwareOnly else '(hw)'}" for i in infos]
            if not self.plugin.override_used or not self.plugin.can_override() or len(infos) < 2:
                self.plugin.diag.once(f"dec:{names}", f"getDecoderInfos(av01) = {names}")
                return
            prefer_dav1d = self.plugin.get_setting("prefer_dav1d", True)

            def rank(info):
                name = str(info.name).lower()
                return (
                    0 if info.softwareOnly else 1,
                    0 if prefer_dav1d and DAV1D_MARK in name else 1,
                )

            ordered = sorted(infos, key=rank)
            new_names = [f"{i.name}{'(sw)' if i.softwareOnly else '(hw)'}" for i in ordered]
            self.plugin.diag.once(f"dec:{names}:{new_names}", f"getDecoderInfos(av01) = {names} -> {new_names}")
            if new_names == names:
                return
            result = ArrayList()
            for info in ordered:
                result.add(info)
            param.setResult(result)
        except Exception:
            self.plugin.diag.exception("getDecoderInfos")


class CreateCodecHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            name = str(param.args[0])
            if "av1" not in name.lower() and "av01" not in name.lower():
                return
            error = param.getThrowable()
            self.plugin.diag.add(f"MediaCodec.createByCodecName({name})" + (f" FAILED: {error}" if error else " ok"))
            self.plugin.diag.schedule("av1_codec_created", 15)
        except Exception:
            self.plugin.diag.exception("createByCodecName")


class RenderersFactoryHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if self.plugin.can_override():
                param.thisObject.setEnableDecoderFallback(True)
        except Exception:
            self.plugin.diag.exception("DefaultRenderersFactory")


class AV1SoftwareDecoderPlugin(BasePlugin):
    def on_plugin_load(self):
        self.override_used = False
        self.sw_failed = False
        self.hw_decoders, self.sw_decoders = [], []
        self.hook_status = {}
        self.diag = Diagnostics(self)
        try:
            self._install()
        except Exception:
            self.diag.exception("on_plugin_load")
        self.diag.schedule("load", 10)

    def on_plugin_unload(self):
        self.diag.cancel()

    def _install(self):
        self.hw_decoders, self.sw_decoders = scan_av1_decoders()
        self.diag.add(f"plugin {__version__} loaded; AV1 decoders: hw={self.hw_decoders} sw={self.sw_decoders}")

        if not self.sw_decoders:
            self.diag.add("no software AV1 decoder in system, plugin is idle")
            return

        video_player = load_class("org.telegram.ui.Components.VideoPlayer")
        if video_player is None:
            self.hook_status["VideoPlayer"] = "class not found"
            return

        string_class = load_class("java.lang.String")
        self._hook("VideoPlayer.supportsHardwareDecoder", lambda: self.hook_method(
            video_player.getDeclaredMethod("supportsHardwareDecoder", string_class),
            SupportsDecoderHook(self),
        ))
        self._hook("VideoPlayer.getQualities",
                   lambda: self.hook_all_methods(video_player, "getQualities", QualitiesHook(self)))
        self._hook("VideoPlayer.getQualityForPlayer",
                   lambda: self.hook_all_methods(video_player, "getQualityForPlayer", QualityForPlayerHook(self)))
        self._hook("VideoPlayer.onPlayerError",
                   lambda: self.hook_all_methods(video_player, "onPlayerError", PlayerErrorHook(self)))
        self._hook("VideoPlayer.onRenderedFirstFrame",
                   lambda: self.hook_all_methods(video_player, "onRenderedFirstFrame", FirstFrameHook(self)))
        self._hook("MediaCodec.createByCodecName", lambda: self.hook_method(
            load_class("android.media.MediaCodec").getDeclaredMethod("createByCodecName", string_class),
            CreateCodecHook(self),
        ))

        codec_util = load_class("androidx.media3.exoplayer.mediacodec.MediaCodecUtil")
        if codec_util is None:
            self.hook_status["MediaCodecUtil"] = "class not found"
        else:
            self._hook("MediaCodecUtil.getDecoderInfos", lambda: self.hook_method(
                codec_util.getDeclaredMethod("getDecoderInfos", string_class, Boolean.TYPE, Boolean.TYPE),
                DecoderInfosHook(self),
            ))

        renderers_factory = load_class("androidx.media3.exoplayer.DefaultRenderersFactory")
        if renderers_factory is None:
            self.hook_status["DefaultRenderersFactory"] = "class not found"
        else:
            self._hook("DefaultRenderersFactory.<init>",
                       lambda: self.hook_all_constructors(renderers_factory, RenderersFactoryHook(self)))
        self.diag.add(f"hooks: {self.hook_status}")

    def _hook(self, label, install):
        try:
            result = install()
            self.hook_status[label] = "ok" if result else "empty"
        except Exception as e:
            self.hook_status[label] = f"error: {e}"

    def environment(self) -> dict:
        env = {
            "plugin_version": __version__,
            "android_api": Build.VERSION.SDK_INT,
            "device": f"{Build.MANUFACTURER} {Build.MODEL}",
            "hardware": Build.HARDWARE,
            "abi": Build.SUPPORTED_ABIS[0] if Build.SUPPORTED_ABIS else "",
            "hw_decoders": self.hw_decoders,
            "sw_decoders": self.sw_decoders,
            "hooks": self.hook_status,
            "override_used": self.override_used,
            "sw_failed": self.sw_failed,
            "settings": {
                "enabled": self.get_setting("enabled", True),
                "mode": self.mode(),
                "max_res": self.get_setting("max_res", MAX_RES_DEFAULT),
                "prefer_dav1d": self.get_setting("prefer_dav1d", True),
            },
        }
        try:
            if Build.VERSION.SDK_INT >= 31:
                env["soc"] = f"{Build.SOC_MANUFACTURER} {Build.SOC_MODEL}"
            from org.telegram.messenger import BuildVars, MessagesController
            env["app_version"] = f"{BuildVars.BUILD_VERSION_STRING} ({BuildVars.BUILD_VERSION})"
            env["unsupport_flag"] = MessagesController.getGlobalMainSettings().getBoolean(UNSUPPORTED_PREF, False)
        except Exception as e:
            env["env_error"] = str(e)
        return env

    def can_override(self) -> bool:
        return bool(self.sw_decoders) and not self.sw_failed and self.get_setting("enabled", True)

    def mode(self) -> int:
        return self.get_setting("mode", MODE_FALLBACK)

    def max_p(self) -> int:
        index = self.get_setting("max_res", MAX_RES_DEFAULT)
        return MAX_RES_VALUES[index] if 0 <= index < len(MAX_RES_VALUES) else MAX_RES_VALUES[MAX_RES_DEFAULT]

    def _status_text(self) -> str:
        def fmt(decoders):
            return ", ".join(f"{n} (до {w}×{h})" if w and h else n for n, w, h in decoders) or "нет"

        lines = [
            f"Android API {Build.VERSION.SDK_INT}",
            f"Аппаратные AV1: {fmt(self.hw_decoders)}",
            f"Программные AV1: {fmt(self.sw_decoders)}",
            f"Сессия диагностики: {self.diag.session}",
        ]
        if not self.sw_decoders:
            lines.append("В системе нет программного AV1-декодера (он есть начиная с Android 10) — плагин ничего не делает.")
        elif self.sw_failed:
            lines.append("Программный декодер выдал ошибку и отключён до перезапуска приложения.")
        return "\n".join(lines)

    def _reset_unsupported_flag(self, *_):
        try:
            from org.telegram.messenger import MessagesController
            MessagesController.getGlobalMainSettings().edit().remove(UNSUPPORTED_PREF).apply()
            set_static_private_field(load_class("org.telegram.ui.Components.VideoPlayer"), "cachedSupportedCodec", None)
            self.sw_failed = False
            self.diag.add("unsupport flag reset by user")
            BulletinHelper.show_success("Флаг сброшен")
        except Exception as e:
            BulletinHelper.show_error(f"Не удалось сбросить: {e}")

    def _send_now(self, *_):
        def worker():
            ok = self.diag.send("manual")
            if ok:
                BulletinHelper.show_success(f"Лог отправлен (сессия {self.diag.session})")
            else:
                BulletinHelper.show_error("Не удалось отправить лог")

        threading.Thread(target=worker, daemon=True).start()

    def create_settings(self) -> List[Any]:
        return [
            Header(text="AV1"),
            Switch(
                key="enabled",
                text="Программный декодер AV1",
                default=True,
                subtext="Работает только если аппаратного AV1 нет",
                icon="msg_video",
            ),
            Selector(
                key="mode",
                text="Когда использовать AV1",
                default=MODE_FALLBACK,
                items=["Только если нет другого кодека", "Всегда, когда есть AV1"],
                icon="msg_settings",
            ),
            Selector(
                key="max_res",
                text="Макс. разрешение AV1",
                default=MAX_RES_DEFAULT,
                items=MAX_RES_ITEMS,
                icon="msg_photo_settings",
            ),
            Switch(
                key="prefer_dav1d",
                text="Предпочитать dav1d",
                default=True,
                subtext="c2.android.av1-dav1d.decoder обычно быстрее libgav1",
                icon="msg_speed",
            ),
            Text(
                text="Сбросить флаг «AV1 не поддерживается»",
                icon="msg_reset",
                on_click=self._reset_unsupported_flag,
            ),
            Header(text="Диагностика"),
            Switch(
                key="send_logs",
                text="Отправлять диагностику",
                default=True,
                subtext="Модель устройства, кодеки, разрешения и ошибки плеера. Без сообщений, ссылок и имён файлов.",
                icon="msg_info",
            ),
            Text(
                text="Отправить лог сейчас",
                icon="msg_retry",
                on_click=self._send_now,
            ),
            Divider(text=self._status_text()),
        ]
